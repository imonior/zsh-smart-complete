# ============================================================
# Recommended .zshrc Config for zsh-smart-complete
#
# Replaces:
#   - zsh-autocomplete      (Tab native completion → plugin does not exec compinit)
#   - zsh-autosuggestions   (inline gray suggestion → plugin's own engine)
# ============================================================

# ------------------------------------------------------------
# 1. History
# ------------------------------------------------------------
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=1000000
export SAVEHIST=1000000

setopt appendhistory          # append to HISTFILE, don't replace on exit
setopt sharehistory           # share history across running zsh instances
setopt histignorealldups      # remove all duplicates of each new line

# ------------------------------------------------------------
# 2. Zsh Native Completion (USER is responsible for compinit)
# ------------------------------------------------------------
autoload -Uz compinit
compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"

# ------------------------------------------------------------
# 3. Zinit Plugin Manager
# ------------------------------------------------------------
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ -f "$ZINIT_HOME/zinit.zsh" ]]; then
    source "$ZINIT_HOME/zinit.zsh"
fi

# ------------------------------------------------------------
# 4. Plugins
# ------------------------------------------------------------
# The installer writes your answers to the questions it asked into the block
# below: the SMART_* options, plus fzf-tab if you opted into it. It is placed
# BEFORE the plugin load on purpose — some options (SMART_MENU_HISTORY_KEYS in
# particular) are read while the plugin installs its key bindings, so setting
# them afterwards would be silently ignored.
#
# Everything between the markers is managed: re-running the installer rewrites
# it. Put your own overrides AFTER the plugin lines instead.
# >>> zsh-smart-complete options (managed) >>>
# <<< zsh-smart-complete options <<<

# Syntax Highlighting (loaded first for visual reasons)
zinit ice wait lucid
zinit light zdharma-continuum/fast-syntax-highlighting

# Smart Complete — replaces both autocomplete + autosuggestions
zinit light imonior/zsh-smart-complete

# After all plugins load, replay compdef calls from plugins that used
# `#compdef` annotations. Only safe AFTER user has run `compinit`.
zinit cdreplay -q

# ------------------------------------------------------------
# 5. External integrations (managed by system/Homebrew, NOT Zinit)
# ------------------------------------------------------------

# Starship prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# zoxide (smart cd replacement)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Atuin (cross-device shell history)
# IMPORTANT: --disable-up-arrow so ↑ stays on zsh-smart-complete's
#            native history channel (3-key model frozen spec).
if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# ------------------------------------------------------------
# Tuning (optional)
# ------------------------------------------------------------
# The options asked about during installation live in the managed block above.
# These are the remaining knobs; uncomment to override. A value set here wins
# over the managed block, because zsh applies the LAST assignment.
#
# Ranking (v0.1.3+) — how history candidates are scored:
# export SMART_RANKING_DECAY_ALPHA=10   # 10=default, higher=faster decay
# export SMART_RANKING_CWD_BOOST=1500   # 1500=1.5x boost for same-dir cmds
#
# Type-to-popup thresholds (v2.2.0+):
# export SMART_MENU_MIN_PREFIX_CMD=2    # chars before listing the command word
# export SMART_MENU_MIN_PREFIX=1        # chars before listing an argument
# export SMART_MENU_MIN_MATCHES=2       # a single candidate stays ghost-text
# export SMART_MENU_MAX_MATCHES=100     # above this the list is not drawn
#
# Throttle, OFF by default: listings measure 10-30ms, so there is nothing to
# throttle. Enable it only for a persistently expensive completion — a skipped
# edit also drops the list that was on screen.
# export SMART_MENU_SLOW_MS=250
# export SMART_MENU_COOLDOWN_KEYS=1
#
# Trace every tick decision to a file ("why is there no popup?"):
# export SMART_MENU_DEBUG=/tmp/zsc-menu.log
#
# Runtime switches (no restart needed):
#   smart-menu off | on | toggle | status     # the type-to-popup
#   smart-suggest off | on                    # the inline grey suggestion
#   smart-status                              # everything at a glance
#   smart-doctor                              # who else is drawing a list?
