# ============================================================
# Recommended .zshrc Config for zsh-smart-complete
#
# Replaces:
#   - zsh-autocomplete      (Tab native completion → plugin does not exec compinit)
#   - zsh-autosuggestions   (inline gray suggestion → plugin's own engine)
# ============================================================

# ------------------------------------------------------------
# 1. History
# ------------------------------------------------------------
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=1000000
export SAVEHIST=1000000

setopt appendhistory          # append to HISTFILE, don't replace on exit
setopt sharehistory           # share history across running zsh instances
setopt histignorealldups      # remove all duplicates of each new line

# ------------------------------------------------------------
# 2. Zsh Native Completion (USER is responsible for compinit)
# ------------------------------------------------------------
autoload -Uz compinit
compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"

# ------------------------------------------------------------
# 3. Zinit Plugin Manager
# ------------------------------------------------------------
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ -f "$ZINIT_HOME/zinit.zsh" ]]; then
    source "$ZINIT_HOME/zinit.zsh"
fi

# ------------------------------------------------------------
# 4. Plugins
# ------------------------------------------------------------
# Syntax Highlighting (loaded first for visual reasons)
zinit ice wait lucid
zinit light zdharma-continuum/fast-syntax-highlighting

# Smart Complete — replaces both autocomplete + autosuggestions
zinit light imonior/zsh-smart-complete

# After all plugins load, replay compdef calls from plugins that used
# `#compdef` annotations. Only safe AFTER user has run `compinit`.
zinit cdreplay -q

# ------------------------------------------------------------
# 5. External integrations (managed by system/Homebrew, NOT Zinit)
# ------------------------------------------------------------

# Starship prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# zoxide (smart cd replacement)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Atuin (cross-device shell history)
# IMPORTANT: --disable-up-arrow so ↑ stays on zsh-smart-complete's
#            native history channel (3-key model frozen spec).
if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# ------------------------------------------------------------
# Optional: Ranking tuning overrides (zsh-smart-complete v0.1.3+)
# ------------------------------------------------------------
#
# export SMART_RANKING_DECAY_ALPHA=10   # 10=default, higher=faster decay
# export SMART_RANKING_CWD_BOOST=1500   # 1500=1.5x boost for same-dir cmds
# export SMART_NATIVE_MENU_SELECT=true  # Tab opens selectable menu

# ------------------------------------------------------------
# Optional: type-to-popup candidate menu (zsh-smart-complete v2.2.0+)
# ------------------------------------------------------------
#
# ON by default: the candidate list is drawn as you type, without pressing Tab
# (the zsh-autocomplete half), alongside the inline grey suggestion
# (the zsh-autosuggestions half). Nothing to configure unless you want to
# change the thresholds:
#
# export SMART_MENU_MIN_PREFIX_CMD=2    # chars before listing the command word
# export SMART_MENU_MIN_PREFIX=1        # chars before listing an argument (0 = also after a space)
# export SMART_MENU_MIN_MATCHES=2       # a single candidate stays ghost-text only
#
# Throttle, OFF by default: listings measure 10-30ms, so there is nothing to
# throttle. Enable it only for a persistently expensive completion; be aware a
# skipped edit also drops the list that was on screen.
# export SMART_MENU_SLOW_MS=250
# export SMART_MENU_COOLDOWN_KEYS=1
#
# Trace every tick decision to a file ("why is there no popup?"):
# export SMART_MENU_DEBUG=/tmp/zsc-menu.log
#
# Turn it off entirely (inline suggestion keeps working):
#   export SMART_MENU=false
# or at runtime:  smart-menu off

